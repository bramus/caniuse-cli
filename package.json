{
  "name": "@bramus/caniuse-cli",
  "version": "1.1.10",
  "description": "Command line tool for “Can I Use…” and MDN Browser Compat Data",
  "keywords": [
    "support",
    "css",
    "js",
    "html5",
    "svg",
    "compat",
    "interop"
  ],
  "main": "index.js",
  "type": "module",
  "bin": {
    "caniuse": "./index.js"
  },
  "scripts": {
    "update-data": "npm update --save caniuse-db @mdn/browser-compat-data web-features && git add package.json && git commit -m \"Update caniuse-db, BCD, and/or web-features\"",
    "lint": "eslint index.js src/ tests/",
    "lintfix": "eslint --fix index.js src/ tests/",
    "tests": "node --test tests/*.test.js",
    "test": "npm run tests",
    "prepublishOnly": "npm run tests"
  },
  "author": "Bramus",
  "license": "MIT",
  "dependencies": {
    "@mdn/browser-compat-data": "^8.0.5",
    "caniuse-db": "^1.0.30001803",
    "omelette": "^0.4.17",
    "web-features": "^3.42.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.30.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bramus/caniuse-cli.git"
  }
}
