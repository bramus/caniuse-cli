{
  "extends": "airbnb-base",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-bitwise": 0,
    "no-console": 0,
    "camelcase": 0,
    "no-plusplus": 0,
    "comma-dangle": 0,
    "no-restricted-syntax": 0,
    "import/extensions": ["error", "ignorePackages"],
    "import/prefer-default-export": 0,
    "no-underscore-dangle": ["error", { "allow": ["__compat", "__meta"] }]
  }
}
